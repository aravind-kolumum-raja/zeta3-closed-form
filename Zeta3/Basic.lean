/-!
# Core Definitions for the $\zeta(3)$ Closed-Form Project

Defines:
* Exact binomial coefficients and the Apéry numbers $a_n = \sum_{k=0}^n \binom{n}{k}^2 \binom{n+k}{k}^2$
* Apéry's cubic recurrence polynomial $P(n) = 34n^3 + 51n^2 + 27n + 5$
* Recurrence-defined rational sequences $a_n, b_n \in \mathbb{Q}$ approximating $\zeta(3)$
-/

namespace Zeta3

/-- Binomial coefficient $\binom{n}{k}$ on `Nat`. -/
def choose : Nat → Nat → Nat
  | _, 0 => 1
  | 0, _ + 1 => 0
  | n + 1, k + 1 => choose n k + choose n (k + 1)

/-- Apéry's cubic recurrence coefficient $P(n) = 34n^3 + 51n^2 + 27n + 5$. -/
def aperyP (n : Nat) : Int :=
  34 * (n : Int) ^ 3 + 51 * (n : Int) ^ 2 + 27 * (n : Int) + 5

/--
Apéry numbers (OEIS A005259):
$$a_n = \sum_{k=0}^{n} \binom{n}{k}^2 \binom{n+k}{k}^2.$$
-/
def aperyNumber (n : Nat) : Nat :=
  (List.range (n + 1)).foldl
    (fun acc k =>
      let c1 := choose n k
      let c2 := choose (n + k) k
      acc + c1 * c1 * c2 * c2)
    0

/-- First six Apéry numbers, verified by computation. -/
theorem aperyNumber_values :
    [aperyNumber 0, aperyNumber 1, aperyNumber 2,
     aperyNumber 3, aperyNumber 4, aperyNumber 5] =
    [1, 5, 73, 1445, 33001, 819005] := by
  decide

/--
Predicate expressing that a sequence `u : Nat → Rat` satisfies Apéry's 3-term recurrence:
$$(n+1)^3 u_{n+1} - P(n) u_n + n^3 u_{n-1} = 0 \qquad (\forall n \ge 1).$$
Written with shifted index `m = n - 1` so it quantifies over all `m : Nat`:
$$(m+2)^3 u_{m+2} - P(m+1) u_{m+1} + (m+1)^3 u_m = 0.$$
-/
def SatisfiesAperyRecurrence (u : Nat → Rat) : Prop :=
  ∀ m : Nat,
    (((m + 2 : Nat) : Rat) ^ 3) * u (m + 2)
      - (aperyP (m + 1) : Rat) * u (m + 1)
      + (((m + 1 : Nat) : Rat) ^ 3) * u m = 0

/-- Generic rational sequence generated by Apéry's recurrence from `(u₀, u₁)`. -/
def aperySeq (u0 u1 : Rat) : Nat → Rat
  | 0 => u0
  | 1 => u1
  | m + 2 =>
      let prev1 := aperySeq u0 u1 (m + 1)
      let prev0 := aperySeq u0 u1 m
      let p : Rat := (aperyP (m + 1) : Rat)
      let c0 : Rat := (((m + 1 : Nat) : Rat) ^ 3)
      let c2 : Rat := (((m + 2 : Nat) : Rat) ^ 3)
      (p * prev1 - c0 * prev0) / c2

/-- Denominator sequence $a_n$ defined via Apéry's recurrence with $a_0 = 1, a_1 = 5$. -/
def aperyA : Nat → Rat := aperySeq 1 5

/-- Numerator sequence $b_n$ defined via Apéry's recurrence with $b_0 = 0, b_1 = 6$. -/
def aperyB : Nat → Rat := aperySeq 0 6

theorem aperyA_first_values :
    [aperyA 0, aperyA 1, aperyA 2, aperyA 3, aperyA 4] =
    [1, 5, 73, 1445, 33001] := by
  simp only [aperyA, aperySeq, aperyP]
  decide +kernel

theorem aperyB_first_values :
    [aperyB 0, aperyB 1, aperyB 2, aperyB 3] =
    [0, 6, (351 : Rat) / 4, (62531 : Rat) / 36] := by
  simp only [aperyB, aperySeq, aperyP]
  decide +kernel

end Zeta3
